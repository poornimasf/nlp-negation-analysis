\f0\b\fs28 \cf0 2.2 Limitations of Pure Syntactic Approaches\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Our corpus analysis reveals critical limitations:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls6\ilvl0
\f0\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Overcorrection Problem
\f1\b0 : Syntactic licensing enables but does not require expletive usage\
\ls6\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Context Sensitivity
